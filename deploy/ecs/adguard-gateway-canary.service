[Unit]
Description=AdGuard Go gateway CANARY (:28080)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=adguard
Group=adguard
EnvironmentFile=/opt/adguard/config/gateway.env
Environment=GATEWAY_HTTP_ADDR=:28080
ExecStart=/opt/adguard/canary/gateway
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
MemoryMax=800M
StandardOutput=append:/opt/adguard/logs/gateway-canary.log
StandardError=append:/opt/adguard/logs/gateway-canary.log

[Install]
WantedBy=multi-user.target
