# AdGuard gateway environment (M6 production; secrets are chmod 600 and NOT in git)
GATEWAY_HTTP_ADDR=:18080
GATEWAY_MYSQL_DSN=adguard:<RDS_PASSWORD>@tcp(<RDS_INTERNAL_HOST>:3306)/adguard?parseTime=true&charset=utf8mb4&loc=UTC
GATEWAY_REDIS_ADDR=127.0.0.1:6379
GATEWAY_MINIO_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
GATEWAY_MINIO_PUBLIC_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
GATEWAY_MINIO_ACCESS_KEY=<RAM_ACCESS_KEY>
GATEWAY_MINIO_SECRET_KEY=<RAM_SECRET>
GATEWAY_MINIO_BUCKET=adguard-assets
GATEWAY_MINIO_USE_SSL=true
GATEWAY_CONTROL_PLANE_URL=http://127.0.0.1:8081
GATEWAY_JUDGE_BACKEND=rule
GATEWAY_PIPELINE_URL=http://127.0.0.1:8090
GATEWAY_PIPELINE_TIMEOUT=10s
GATEWAY_API_KEY=<API_KEY>
