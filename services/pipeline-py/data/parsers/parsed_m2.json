  "rules": [
    {
      "rule_id": "ADV-LAW-ART9-3",
      "family": "absolute_terms",
      "severity": "high",
      "regulation_id": "ADV-LAW",
      "article": "第九条",
      "item": "（三）",
      "clause_id": "ADV-LAW-ART9-ITEM3",
      "text": "使用“国家级”、“最高级”、“最佳”等用语；",
      "canonical_terms": [
        "国家级",
        "最高级",
        "最佳",
        "最好",
        "最高档",
        "最高端",
        "最先进",
        "最科学",
        "最优秀",
        "最顶级",
        "最豪华",
        "最权威",
        "最便宜",
        "最低价",
        "第一",
        "顶级",
        "顶尖",
        "唯一",
        "独家",
        "首个",
        "首选",
        "冠军",
        "王牌",
        "至尊",
        "极致",
        "完美",
        "销冠",
        "全网最低",
        "全球第一",
        "全国第一",
        "销量第一",
        "史上最低",
        "遥遥领先"
      ],
      "penalty_law_ref": "第五十七条",
      "penalty_min": 200000,
      "penalty_max": 1000000,
      "effective_from": "2015-09-01",
      "context_exemptions": [
        "仅表明商品经营者的服务态度或者经营理念、企业文化、主观愿望的；",
        "仅表达商品经营者目标追求的；",
        "绝对化用语指向的内容，与广告中推销的商品性能、质量无直接关联，且不会对消费者产生误导的其他情形。",
        "仅用于对同一品牌或同一企业商品进行自我比较的；",
        "仅用于宣传商品的使用方法、使用时间、保存期限等消费提示的；",
        "依据国家标准、行业标准、地方标准等认定的商品分级用语中含有绝对化用语并能够说明依据的；",
        "商品名称、规格型号、注册商标或者专利中含有绝对化用语，广告中使用商品名称、规格型号、注册商标或者专利来指代商品，以区分其他商品的；",
        "依据国家有关规定评定的奖项、称号中含有绝对化用语的；",
        "在限定具体时间、地域等条件的情况下，表述时空顺序客观情况或者宣传产品销量、销售额、市场占有率等事实信息的。"
      ],
      "source_url": "https://www.chengxiang.gov.cn/ztzl/scjgzf/gzhbz/202207/t20220727_1741581.htm",
      "law": "中华人民共和国广告法"
    },
